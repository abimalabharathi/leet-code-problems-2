class Solution:
    def canSeePersonsCount(self, heights: list[int]) -> list[int]:
        n = len(heights)
        if n == 0: return [0]

        stack = [heights[-1]]
        res = [0] * n

        for i in range(n-2, -1, -1):
            visible = 1
            while stack and stack[-1] < heights[i]:
                stack.pop()
                visible += 1

            res[i] = visible if stack else visible - 1
            stack.append(heights[i])            

            
        
        return res
